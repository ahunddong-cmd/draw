NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (브라우저에 노출되면 안 됨).
# 설정 저장·이미지 업로드 API 라우트에서 PIN 검증 후에만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 예기치 못한 에러가 발생하면 관리자에게 메일로 알린다 (/api/report-error).
# Resend(https://resend.com) 무료 API 키. 미설정 시 메일 없이 서버 로그만 남는다.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# 알림을 받을 관리자 이메일 (미설정 시 ahunddong@gmail.com)
ADMIN_EMAIL=ahunddong@gmail.com
# 발신 주소. Resend에서 도메인 인증 전이면 onboarding@resend.dev 그대로 사용한다.
ERROR_ALERT_FROM=onboarding@resend.dev
